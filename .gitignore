:::writing{variant="document" id="74163" title="HTML — Valeria, ¿quieres salir conmigo?"}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Para Valeria ❤️</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #ff758c, #ff7eb3, #ffb6c1);
      color: white;
      text-align: center;
    }

    .card {
      width: 90%;
      max-width: 430px;
      padding: 35px 25px;
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(12px);
      box-shadow: 0 15px 40px rgba(120, 0, 40, 0.25);
      position: relative;
      z-index: 2;
      animation: aparecer 1.2s ease;
    }

    .emoji {
      font-size: 55px;
      animation: latido 1.3s infinite;
    }

    h1 {
      font-size: 34px;
      margin: 10px 0;
    }

    h2 {
      font-size: 24px;
      line-height: 1.3;
    }

    p {
      font-size: 18px;
      line-height: 1.6;
    }

    .buttons {
      margin-top: 25px;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    button {
      border: none;
      border-radius: 50px;
      padding: 15px 25px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.25s;
    }

    #yes {
      background: white;
      color: #ff4f81;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    #yes:hover {
      transform: scale(1.08);
    }

    #think {
      background: rgba(255,255,255,0.25);
      color: white;
    }

    #message {
      display: none;
      margin-top: 25px;
      font-size: 22px;
      font-weight: bold;
      animation: aparecer 0.8s ease;
    }

    .heart {
      position: fixed;
      bottom: -30px;
      font-size: 22px;
      animation: subir linear forwards;
      pointer-events: none;
      z-index: 1;
    }

    @keyframes subir {
      from {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
      }
      to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
      }
    }

    @keyframes latido {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }

    @keyframes aparecer {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>

<body>

  <div class="card">
    <div class="emoji">💌</div>

    <h1>Valeria...</h1>

    <p>
      Tengo una pregunta importante para ti.
    </p>

    <p>
      Desde que apareciste, mis días tienen un poquito más de sentido,
      mis sonrisas duran un poquito más y, sinceramente...
      creo que ya me gustas demasiado. 🥰
    </p>

    <h2>
      ❤️ Valeria, ¿quieres salir conmigo?
    </h2>

    <div class="buttons">
      <button id="yes" onclick="sayYes()">
        SÍ ❤️
      </button>

      <button id="think" onclick="think()">
        Me lo pienso... 😏
      </button>
    </div>

    <div id="message"></div>
  </div>

  <script>
    function createHeart() {
      const heart = document.createElement("div");
      heart.className = "heart";

      const hearts = ["❤️", "💕", "💗", "💖", "💘"];
      heart.innerHTML = hearts[Math.floor(Math.random() * hearts.length)];

      heart.style.left = Math.random() * 100 + "vw";
      heart.style.animationDuration = (3 + Math.random() * 4) + "s";
      heart.style.fontSize = (15 + Math.random() * 25) + "px";

      document.body.appendChild(heart);

      setTimeout(() => {
        heart.remove();
      }, 7000);
    }

    setInterval(createHeart, 350);

    function sayYes() {
      const message = document.getElementById("message");

      message.innerHTML = `
        🥹❤️ ¡SABÍA QUE DIRÍAS QUE SÍ! ❤️🥹
        <br><br>
        Entonces queda oficialmente inaugurada
        nuestra primera cita. 😏💕
        <br><br>
        Prometo hacer que valga la pena. 🫶
      `;

      message.style.display = "block";

      for (let i = 0; i < 30; i++) {
        setTimeout(createHeart, i * 80);
      }
    }

    function think() {
      const message = document.getElementById("message");

      message.innerHTML = `
        🤨 ¿Pensártelo?
        <br><br>
        Vale... pero mientras tanto
        yo voy preparando la cita. 😂❤️
      `;

      message.style.display = "block";
    }
  </script>

</body>
</html>
:::
